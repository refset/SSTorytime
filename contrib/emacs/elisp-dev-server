#!/bin/bash
# elisp-dev-server - Manage the elisp-dev REPL server

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_FILE="$SCRIPT_DIR/elisp-dev-server.el"
PID_FILE="$HOME/.emacs.d/elisp-dev/server.pid"
LOG_FILE="$HOME/.emacs.d/elisp-dev/server.log"
PORT=9999

mkdir -p "$(dirname "$PID_FILE")"

case "$1" in
    start)
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "Server already running (PID: $(cat "$PID_FILE"))"
            exit 0
        fi

        echo "Starting elisp-dev server on port $PORT..."
        nohup emacs --batch -l "$SERVER_FILE" \
            -f elisp-dev-server-start \
            > "$LOG_FILE" 2>&1 &

        SERVER_PID=$!
        echo $SERVER_PID > "$PID_FILE"

        # Wait for server to start
        sleep 1

        if kill -0 $SERVER_PID 2>/dev/null; then
            echo "✓ Server started (PID: $SERVER_PID)"
            echo "  Log: $LOG_FILE"
            echo "  Test: elisp-dev-client ping"
        else
            echo "✗ Server failed to start. Check $LOG_FILE"
            rm -f "$PID_FILE"
            exit 1
        fi
        ;;

    stop)
        if [ ! -f "$PID_FILE" ]; then
            echo "Server not running (no PID file)"
            exit 0
        fi

        PID=$(cat "$PID_FILE")
        if kill -0 $PID 2>/dev/null; then
            echo "Stopping server (PID: $PID)..."
            kill $PID
            rm -f "$PID_FILE"
            echo "✓ Server stopped"
        else
            echo "Server not running (stale PID file)"
            rm -f "$PID_FILE"
        fi
        ;;

    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;

    status)
        if [ -f "$PID_FILE" ]; then
            PID=$(cat "$PID_FILE")
            if kill -0 $PID 2>/dev/null; then
                echo "✓ Server running (PID: $PID)"
                echo "  Port: $PORT"
                echo "  Log: $LOG_FILE"

                # Try to ping
                if timeout 1 bash -c "echo '{\"command\":\"ping\",\"args\":[]}' | socat - TCP:localhost:$PORT" >/dev/null 2>&1; then
                    echo "  Status: Responding to requests"
                else
                    echo "  Status: Not responding (may be starting up)"
                fi
                exit 0
            else
                echo "✗ Server not running (stale PID file)"
                rm -f "$PID_FILE"
                exit 1
            fi
        else
            echo "✗ Server not running"
            exit 1
        fi
        ;;

    logs)
        if [ -f "$LOG_FILE" ]; then
            tail -f "$LOG_FILE"
        else
            echo "No log file found"
            exit 1
        fi
        ;;

    help|--help|-h)
        cat <<EOF
elisp-dev-server - Manage the elisp-dev REPL server

Usage: elisp-dev-server <command>

Commands:
  start      Start the server
  stop       Stop the server
  restart    Restart the server
  status     Check server status
  logs       Tail server logs
  help       Show this help

The server provides fast Elisp introspection via a persistent Emacs process.
Use elisp-dev-client to send queries to the server.

Examples:
  elisp-dev-server start
  elisp-dev-server status
  elisp-dev-client df car
EOF
        ;;

    *)
        echo "Unknown command: $1"
        echo "Use 'elisp-dev-server help' for usage"
        exit 1
        ;;
esac
